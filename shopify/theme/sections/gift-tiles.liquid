<section class="section section--surface">
  <div class="container">
    <div class="section__head section__head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <a class="tile" href="{{ p.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="tile__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.label }}
            {%- elsif p.featured_media -%}
              {{ p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.label }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <p class="tile__label">{{ block.settings.label }}</p>
          {%- if p != blank -%}<p class="tile__sub">{{ p.title }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Gift finder tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Gift finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who are you shopping for?" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "For the homebody" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image (product image used if empty)" }
      ]
    }
  ],
  "presets": [{ "name": "Gift finder tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
