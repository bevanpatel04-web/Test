<section class="trust {% if section.settings.dark %}trust--dark{% endif %}">
  <div class="container trust__grid">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        {% render 'icon', icon: block.settings.icon %}
        <div>
          <p class="trust__title">{{ block.settings.title }}</p>
          <p class="trust__text">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Trust bar",
  "settings": [{ "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "lock", "label": "Lock" },
          { "value": "gift", "label": "Gift" }, { "value": "heart", "label": "Heart" }, { "value": "chat", "label": "Chat" }, { "value": "leaf", "label": "Leaf" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free US shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order, no minimum" }
      ]
    }
  ],
  "presets": [{ "name": "Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
