<section class="password">
  <div class="container container--narrow center">
    <p class="wordmark">{{ shop.name }}</p>
    <h1 class="h1">Opening soon</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'news-form news-form--center' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}
        <p>Thanks! We'll email you when we open.</p>
      {%- else -%}
        <label class="visually-hidden" for="PwEmail">Email</label>
        <input id="PwEmail" type="email" name="contact[email]" placeholder="Email address" required>
        <button type="submit" class="btn">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="muted small">Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="Password">Password</label>
        <input type="password" name="password" id="Password" placeholder="Password">
        <button type="submit" class="btn btn--ghost">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
