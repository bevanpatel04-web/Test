{%- liquid
  assign collection = section.settings.collection | default: collections.all
-%}
<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="link-arrow">View all</a>
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}{% render 'product-card', product: blank %}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most-gifted this season" },
    { "type": "collection", "id": "collection", "label": "Collection (all products if empty)" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "5", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }] }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
