<section class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {% render 'section-image', image: section.settings.image, fallback_url: section.settings.fallback_url, alt: section.settings.heading, sizes: '100vw', class: 'hero__img', loading: 'eager' %}
  </div>
  <div class="hero__overlay" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
  <div class="container hero__content hero__content--{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--light btn--large">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn--outline-light btn--large">{{ section.settings.button2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_url", "label": "Image URL (used when no image is uploaded)", "default": "https://images.unsplash.com/photo-1639109743189-91a3ec8b0437?auto=format&fit=crop&q=80" },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [{ "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }] },
    { "type": "select", "id": "align", "label": "Text position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "The Winter Gift Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Warmth, wrapped." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Soft, thoughtful gifts for slow mornings and long nights in. Free US shipping, 30-day returns." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the edit" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Gift bundles" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
