<section class="section section--tight">
  <div class="container">
    <h1 class="h1">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <article class="card">
            <a href="{{ article.url }}" class="card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title, class: 'card__img' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'card__placeholder' }}{%- endif -%}
            </a>
            <div class="card__info">
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="muted small">{{ article.published_at | time_tag: format: 'date' }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
