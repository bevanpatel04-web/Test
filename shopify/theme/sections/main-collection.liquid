<section class="section section--tight">
  <div class="container">
    <div class="collection-head">
      <p class="eyebrow">Collection</p>
      <h1 class="h1">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<div class="rte collection-head__desc">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="toolbar">
        <span class="muted">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</span>
        <label class="toolbar__sort">
          <span class="visually-hidden">Sort by</span>
          <select data-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == collection.sort_by or option.value == collection.default_sort_by and collection.sort_by == blank %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
      </div>
      <div class="grid grid--4">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="muted">No products yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection products",
  "settings": [{ "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }]
}
{% endschema %}
