<section class="section section--tight">
  <div class="container">
    <h1 class="h1">Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn">Search</button>
    </form>
    {%- if search.performed -%}
      <p class="muted">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms | escape }}”</p>
      <div class="grid grid--4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
